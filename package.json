{
  "name": "arretado",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma pessoal de preparação para concursos jurídicos (local-first).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run --project unidade --exclude src/dominios/legislacao/desempenho.test.ts && vitest run --project unidade src/dominios/legislacao/desempenho.test.ts",
    "test:watch": "vitest --project unidade",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "tamanho": "node scripts/tamanho-do-pacote.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run audit",
    "carga": "vitest run --project carga",
    "corpus": "node scripts/corpus-normas.mjs",
    "corpus:colar": "node scripts/corpus-colar.mjs",
    "corpus:gabarito": "node scripts/corpus-gabarito.mjs",
    "fim-do-dia": "node scripts/fim-do-dia.mjs",
    "hooks:instalar": "node scripts/instalar-hooks.mjs",
    "acervo:gerar": "node scripts/acervo.mjs gerar",
    "acervo:verificar": "node scripts/acervo.mjs verificar",
    "catalogo": "node scripts/catalogo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-virtual": "^3.14.13",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.15",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright-core": "1.56.1",
    "prettier": "^3.9.8",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  }
}
