// Hospedagem no Cloudflare Workers só com arquivos estáticos (T18): o site é a pasta dist/ do
// `npm run build`, e o dist/_headers (gerado a partir de config/seguranca.ts) aplica a CSP e os
// demais cabeçalhos. Publicado pelo Workers Builds a cada push no main.
// A rota /api/buscar-norma (T17, atividade 12.1) entra aqui como "main" + assets.run_worker_first.
{
  "name": "arretado",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
  },
}
