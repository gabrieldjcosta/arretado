Del2848.htm#art223"},{"texto":";"}],"notasVigencia":[{"texto":"(Vide Decreto-Lei nº 2.848, de 1940)","lei":"Decreto-Lei nº 2.848","ano":1940,"link":"https://www.planalto.gov.br/ccivil_03/Decreto-Lei/Del2848.htm#art223"}]},{"endereco":"art1.incIII.alG","categoria":"normativo","tipo":"alinea","rotulo":"g)","status":"vigente","confianca":"alta","pai":"art1.incIII","trechos":[{"texto":"atentado violento ao pudor "},{"texto":"(art. 214, caput","link":"https://www.planalto.gov.br/ccivil_03/Decreto-Lei/Del2848.htm#art214"},{"texto":", e sua combinação com o "},{"texto":"art. 223, caput, e parágrafo único)","link":"https://www.planalto.gov.br/ccivil_03/Decreto-Lei/Del2848.htm#art223"},{"texto":";"}],"notasVigencia":[{"texto":"(Vide Decreto-Lei nº 2.848, de 1940)","lei":"Decreto-Lei nº 2.848","ano":1940,"link":"https://www.planalto.gov.br/ccivil_03/Decreto-Lei/Del2848.htm#art223"}]},{"endereco":"art1.incIII.alH","categoria":"normativo","tipo":"alinea","rotulo":"h)","status":"vigente","confianca":"alta","pai":"art1.incIII","trechos":[{"texto":"rapto violento "},{"texto":"(art. 219","link":"https://www.planalto.gov.br/ccivil_03/Decreto-Lei/Del2848.htm#art219"},{"texto":", e sua combinação com o "},{"texto":"art. 223 caput, e parágrafo único)","link":"https://www.planalto.gov.br/ccivil_03/Decreto-Lei/Del2848.htm#art223"},{"texto":";"}],"notasVigencia":[{"texto":"(Vide Decreto-Lei nº 2.848, de 1940)","lei":"Decreto-Lei nº 2.848","ano":1940,"link":"https://www.planalto.gov.br/ccivil_03/Decreto-Lei/Del2848.htm#art219"}]},{"endereco":"art1.incIII.alI","categoria":"normativo","tipo":"alinea","rotulo":"i)","status":"vigente","confianca":"alta","pai":"art1.incIII","trechos":[{"texto":"epidemia com resultado de morte "},{"texto":"(art. 267, § 1º)","link":"https://www.planalto.gov.br/ccivil_03/Decreto-Lei/Del2848.htm#art267%C2%A71"},{"texto":";"}]},{"endereco":"art1.incIII.alJ","categoria":"normativo","tipo":"alinea","rotulo":"j)","status":"vigente","confianca":"alta","pai":"art1.incIII","trechos":[{"texto":"envenenamento de água potável ou substância alimentícia ou medicinal qualificado pela morte ("},{"texto":"art. 270, caput","link":"https://www.planalto.gov.br/ccivil_03/Decreto-Lei/Del2848.htm#art270"},{"texto":", combinado com "},{"texto":"art. 285","link":"https://www.planalto.gov.br/ccivil_03/Decreto-Lei/Del2848.htm#art285"},{"texto":");"}]},{"endereco":"art1.incIII.alL","categoria":"normativo","tipo":"alinea","rotulo":"l)","status":"vigente","confianca":"alta","pai":"art1.incIII","trechos":[{"texto":"quadrilha ou bando "},{"texto":"(art. 288)","link":"https://www.planalto.gov.br/ccivil_03/Decreto-Lei/Del2848.htm#art288"},{"texto":", todos do Código Penal;"}]},{"endereco":"art1.incIII.alM","categoria":"normativo","tipo":"alinea","rotulo":"m)","status":"vigente","confianca":"alta","pai":"art1.incIII","trechos":[{"texto":"genocídio "},{"texto":"(arts. 1º","link":"https://www.planalto.gov.br/ccivil_03/leis/L2889.htm#art1"},{"texto":", "},{"texto":"2º","link":"https://www.planalto.gov.br/ccivil_03/leis/L2889.htm#art2"},{"texto":" e "},{"texto":"3º da Lei nº 2.889, de 1º de outubro de 1956","link":"https://www.planalto.gov.br/ccivil_03/leis/L2889.htm#art3"},{"texto":"), em qualquer de sua formas típicas;"}]},{"endereco":"art1.incIII.alN","categoria":"normativo","tipo":"alinea","rotulo":"n)","status":"vigente","confianca":"alta","pai":"art1.incIII","trechos":[{"texto":"tráfico de drogas "},{"texto":"(art. 12 da Lei nº 6.368, de 21 de outubro de 1976)","link":"https://www.planalto.gov.br/ccivil_03/leis/L6368.htm#art12"},{"texto":";"}]},{"endereco":"art1.incIII.alO","categoria":"normativo","tipo":"alinea","rotulo":"o)","status":"vigente","confianca":"alta","pai":"art1.incIII","trechos":[{"texto":"crimes contra o sistema financeiro ("},{"texto":"Lei nº 7.492, de 16 de junho de 1986","link":"https://www.planalto.gov.br/ccivil_03/leis/L7492.htm"},{"texto":")."}]},{"endereco":"art1.incIII.alP","categoria":"normativo","tipo":"alinea","rotulo":"p)","status":"vigente","confianca":"alta","pai":"art1.incIII","trechos":[{"texto":"crimes previstos na Lei de Terrorismo."}],"notasVigencia":[{"texto":"(Incluído pela Lei nº 13.260, de 2016)","lei":"Lei nº 13.260","ano":2016,"link":"https://www.planalto.gov.br/ccivil_03/_Ato2015-2018/2016/Lei/L13260.htm#art18"}]},{"endereco":"art2","categoria":"normativo","tipo":"artigo","rotulo":"Art. 2º","status":"vigente","confianca":"alta","trechos":[{"texto":"A prisão temporária será decretada pelo Juiz, em face da representação da autoridade policial ou de requerimento do Ministério Público, e terá o prazo de 5 (cinco) dias, prorrogável por igual período em caso de extrema e comprovada necessidade."}]},{"endereco":"art2.par1","categoria":"normativo","tipo":"paragrafo","rotulo":"§ 1º","status":"vigente","confianca":"alta","pai":"art2","trechos":[{"texto":"Na hipótese de representação da autoridade policial, o Juiz, antes de decidir, ouvirá o Ministério Público."}]},{"endereco":"art2.par2","categoria":"normativo","tipo":"paragrafo","rotulo":"§ 2º","status":"vigente","confianca":"alta","pai":"art2","trechos":[{"texto":"O despacho que decretar a prisão temporária deverá ser fundamentado e prolatado dentro do prazo de 24 (vinte e quatro) horas, contadas a partir do recebimento da representação ou do requerimento."}]},{"endereco":"art2.par3","categoria":"normativo","tipo":"paragrafo","rotulo":"§ 3º","status":"vigente","confianca":"alta","pai":"art2","trechos":[{"texto":"O Juiz poderá, de ofício, ou a requerimento do Ministério Público e do Advogado, determinar que o preso lhe seja apresentado, solicitar informações e esclarecimentos da autoridade policial e submetê-lo a exame de corpo de delito."}]},{"endereco":"art2.par4","categoria":"normativo","tipo":"paragrafo","rotulo":"§ 4º","status":"vigente","confianca":"alta","pai":"art2","trechos":[{"texto":"Decretada a prisão temporária, expedir-se-á mandado de prisão, em duas vias, uma das quais será entregue ao indiciado e servirá como nota de culpa."}]},{"endereco":"art2.par4A","categoria":"normativo","tipo":"paragrafo","rotulo":"§ 4º-A","status":"vigente","confianca":"alta","pai":"art2","trechos":[{"texto":"O mandado de prisão conterá necessariamente o período de duração da prisão temporária estabelecido no "},{"texto":"caput","enfase":true},{"texto":" deste artigo, bem como o dia em que o preso deverá ser libertado."}],"notasVigencia":[{"texto":"(Incluído pela Lei nº 13.869. de 2019)","lei":"Lei nº 13.869","ano":2019,"link":"https://www.planalto.gov.br/ccivil_03/_Ato2019-2022/2019/Lei/L13869.htm#art40"}]},{"endereco":"art2.par5","categoria":"normativo","tipo":"paragrafo","rotulo":"§ 5º","status":"vigente","confianca":"alta","pai":"art2","trechos":[{"texto":"A prisão somente poderá ser executada depois da expedição de mandado judicial."}]},{"endereco":"art2.par6","categoria":"normativo","tipo":"paragrafo","rotulo":"§ 6º","status":"vigente","confianca":"alta","pai":"art2","trechos":[{"texto":"Efetuada a prisão, a autoridade policial informará o preso dos direitos previstos no art. 5º da Constituição Federal."}]},{"endereco":"art2.par7","categoria":"normativo","tipo":"paragrafo","rotulo":"§ 7º","status":"vigente","confianca":"alta","pai":"art2","trechos":[{"texto":"Decorrido o prazo contido no mandado de prisão, a autoridade responsável pela custódia deverá, independentemente de nova ordem da autoridade judicial, pôr imediatamente o preso em liberdade, salvo se já tiver sido comunicada da prorrogação da prisão temporária ou da decretação da prisão preventiva."}],"notasVigencia":[{"texto":"(Redação dada pela Lei nº 13.869. de 2019)","lei":"Lei nº 13.869","ano":2019,"link":"https://www.planalto.gov.br/ccivil_03/_Ato2019-2022/2019/Lei/L13869.htm#art40"}],"redacoesAnteriores":[{"trechos":[{"texto":"§ 7º Decorrido o prazo de cinco dias de detenção, o preso deverá ser posto imediatamente em liberdade, salvo se já tiver sido decretada sua prisão preventiva.","tachado":true}],"origemDeteccao":"tachado","confirmada":true}]},{"endereco":"art2.par8","categoria":"normativo","tipo":"paragrafo","rotulo":"§ 8º","status":"vigente","confianca":"alta","pai":"art2","trechos":[{"texto":"Inclui-se o dia do cumprimento do mandado de prisão no cômputo do prazo de prisão temporária."}],"notasVigencia":[{"texto":"(Incluído pela Lei nº 13.869. de 2019)","lei":"Lei nº 13.869","ano":2019,"link":"https://www.planalto.gov.br/ccivil_03/_Ato2019-2022/2019/Lei/L13869.htm#art40"}]},{"endereco":"art3","categoria":"normativo","tipo":"artigo","rotulo":"Art. 3º","status":"vigente","confianca":"alta","trechos":[{"texto":"Os presos temporários deverão permanecer, obrigatoriamente, separados dos demais detentos."}]},{"endereco":"art4","categoria":"normativo","tipo":"artigo","rotulo":"Art. 4º","status":"vigente","confianca":"alta","trechos":[{"texto":"O "},{"texto":"art. 4º da Lei nº 4.898, de 9 de dezembro de 1965,","link":"https://www.planalto.gov.br/ccivil_03/leis/L4898.htm#art4"},{"texto":" fica acrescido da alínea i, com a seguinte redação:"},{"texto":"\n"},{"texto":"\"Art. 4º ..............................................................."},{"texto":"\n"},{"texto":"i) prolongar a execução de prisão temporária, de pena ou de medida de segurança, deixando de expedir em tempo oportuno ou de cumprir imediatamente ordem de liberdade;\""}]},{"endereco":"art5","categoria":"normativo","tipo":"artigo","rotulo":"Art. 5º","status":"vigente","confianca":"alta","trechos":[{"texto":"Em todas as comarcas e seções judiciárias haverá um plantão permanente de vinte e quatro horas do Poder Judiciário e do Ministério Público para apreciação dos pedidos de prisão temporária."}]},{"endereco":"art6","categoria":"normativo","tipo":"artigo","rotulo":"Art. 6º","status":"vigente","confianca":"alta","trechos":[{"texto":"Esta Lei entra em vigor na data de sua publicação."}]},{"endereco":"art7","categoria":"normativo","tipo":"artigo","rotulo":"Art. 7º","status":"vigente","confianca":"alta","trechos":[{"texto":"Revogam-se as disposições em contrário."}]}]}