,"trechos":[{"texto":"OPTANTE: Nome civil completo, nacionalidade, naturalidade, data e local do nascimento, estado civil,profissão, RG, CPF, endereço completo, telefone, endereço eletrônico."}]},{"endereco":"art3.par2.incI.nome","categoria":"normativo","tipo":"nome","status":"vigente","confianca":"media","pai":"art3.par2.incI","trechos":[{"texto":"OFICIAL DE REGISTRO CIVIL DAS PESSOAS NATURAIS DO MUNICÍPIO DE ..."}]},{"endereco":"art3.par2.incII","categoria":"normativo","tipo":"inciso","rotulo":"II","status":"vigente","confianca":"alta","pai":"art3.par2","trechos":[{"texto":"REPRESENTANTE(S) OU ASSISTENTE(S): Nome civil completo, nacionalidade, naturalidade, data e local do nascimento, estado civil,profissão, RG, CPF, endereço completo, telefone, endereço eletrônico."}]},{"endereco":"art3.par2.incIII","categoria":"normativo","tipo":"inciso","rotulo":"III","status":"vigente","confianca":"alta","pai":"art3.par2","trechos":[{"texto":"OPÇÃO:"},{"texto":"\n"},{"texto":"Consta no assento de nascimento da pessoa optante a indicação do sexo “ignorado”.Solicito a averbação da opção pelo sexo (masculino ou feminino) no assento denascimento."}]},{"endereco":"art3.par2.incIV","categoria":"normativo","tipo":"inciso","rotulo":"IV","status":"vigente","confianca":"alta","pai":"art3.par2","trechos":[{"texto":"PRENOME: A pessoa optante não deseja alterar o prenome. OU Solicito seja alterado o prenome da pessoa optante, averbando-se o novo prenome... Local e data. Assinaturas."}]}]}