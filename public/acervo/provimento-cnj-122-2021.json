{"id":"provimento-cnj-122-2021","versao":1,"norma":{"tituloCurto":"Provimento CNJ 122/2021 - Assento de nascimento com campo sexo ignorado na DNV/DO","tipo":"Provimento","esfera":"federal","urlOficial":"https://atos.cnj.jus.br/atos/detalhar/4066","fonteConsultadaEm":"2026-10-13"},"nos":[{"endereco":"art1","categoria":"normativo","tipo":"artigo","rotulo":"Art. 1º","status":"vigente","confianca":"alta","trechos":[{"texto":"Este Provimento dispõe sobre o assento de nascimento no Registro Civil das Pessoas Naturais nos casos em que o campo sexo da Declaração de Nascido Vivo (DNV), ou da Declaração de Óbito (DO) fetal, tenha sido preenchido “ignorado”."}]},{"endereco":"art2","categoria":"normativo","tipo":"artigo","rotulo":"Art. 2º","status":"revogado","confianca":"alta","trechos":[],"notasVigencia":[{"texto":"(revogado pelo Provimento CN n. 149, de 30.8.2023)"}]},{"endereco":"art2.par1","categoria":"normativo","tipo":"paragrafo","rotulo":"§ 1º","status":"revogado","confianca":"alta","pai":"art2","trechos":[],"notasVigencia":[{"texto":"(revogado pelo Provimento CN n. 149, de 30.8.2023)"}]},{"endereco":"art2.par2","categoria":"normativo","tipo":"paragrafo","rotulo":"§ 2º","status":"revogado","confianca":"alta","pai":"art2","trechos":[],"notasVigencia":[{"texto":"(revogado pelo Provimento CN n. 149, de 30.8.2023)"}]},{"endereco":"art2.par3","categoria":"normativo","tipo":"paragrafo","rotulo":"§ 3º","status":"revogado","confianca":"alta","pai":"art2","trechos":[],"notasVigencia":[{"texto":"(revogado pelo Provimento CN n. 149, de 30.8.2023)"}]},{"endereco":"art3","categoria":"normativo","tipo":"artigo","rotulo":"Art. 3º","status":"revogado","confianca":"alta","trechos":[],"notasVigencia":[{"texto":"(revogado pelo Provimento CN n. 149, de 30.8.2023)"}]},{"endereco":"art3.par3","categoria":"normativo","tipo":"paragrafo","rotulo":"§ 3º","status":"revogado","confianca":"alta","pai":"art3","trechos":[],"notasVigencia":[{"texto":"(revogado pelo Provimento CN n. 149, de 30.8.2023)"