{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node .claude/hooks/backup-diario.mjs" }] }],
    "PreToolUse": [
      { "matcher": "Bash|Read", "hooks": [{ "type": "command", "command": "node .claude/hooks/guarda.mjs" }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node .claude/hooks/check-antes-do-commit.mjs", "timeout": 600 }] }
    ],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node .claude/hooks/parada.mjs", "timeout": 600 }] }]
  }
}
